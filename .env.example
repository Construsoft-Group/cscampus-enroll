# Server
PORT=4000

# Database (MySQL / MariaDB)
# In Heroku the JawsDB add-on injects JAWSDB_MARIA_URL (mysql://user:pass@host:port/db)
# and it takes precedence. The discrete variables below are the fallback for local dev.
# JAWSDB_MARIA_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Moodle API
MDL_DOMAIN=https://your-moodle-domain.com
MDL_TOKEN=
MDL_TIMEOUT_MS=20000

# Email (SMTP - cloud01.dowhilestudio.com)
MAIL_ACCOUNT=
MAIL_PASS=

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=

# SharePoint (currently unused - file upload feature is commented out)
# To re-enable: register an app in Azure AD and grant SharePoint permissions
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_TENANT_ID=
SP_TENANT_NAME=
SP_REFRESHTOKEN=
